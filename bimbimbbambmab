-- [[ HOTKEY SYSTEM ]] --
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    -- Handle setting keybind
    if keybindAwaitingInput and input.UserInputType == Enum.UserInputType.Keyboard then
        local keyName = tostring(input.KeyCode):match("KeyCode%.(.+)") or "Unknown"
        keybinds[keybindAwaitingInput.keyName] = input.KeyCode
        keybindAwaitingInput.btn.Text = "Key: " .. keyName
        keybindAwaitingInput.btn.TextColor3 = THEME.Accent
        keybindAwaitingInput = nil
        return
    end

    -- Handle feature toggling
    if not gameProcessed and input.UserInputType == Enum.UserInputType.Keyboard then
        local pressedKey = input.KeyCode
        
        if pressedKey == keybinds.combatEnabled then
            flags.combat.enabled = not flags.combat.enabled
        elseif pressedKey == keybinds.autoSwing then
            flags.combat.autoSwing = not flags.combat.autoSwing
        elseif pressedKey == keybinds.hitboxExpand then
            flags.combat.hitboxExpand = not flags.combat.hitboxExpand
        elseif pressedKey == keybinds.autoFish then
            flags.farming.autoFish = not flags.farming.autoFish
        elseif pressedKey == keybinds.speedEnabled then
            flags.movement.speedEnabled = not flags.movement.speedEnabled
        elseif pressedKey == keybinds.flight then
            flags.movement.fly = not flags.movement.fly
        elseif pressedKey == keybinds.noclip then
            flags.movement.noclip = not flags.movement.noclip
        elseif pressedKey == keybinds.wallWalk then
            flags.movement.wallWalk = not flags.movement.wallWalk
        elseif pressedKey == keybinds.infJump then
            flags.movement.infJump = not flags.movement.infJump
        elseif pressedKey == keybinds.autoClick then
            flags.utility.autoClick = not flags.utility.autoClick
        elseif pressedKey == keybinds.playerEsp then
            flags.player.playerEsp = not flags.player.playerEsp
        elseif pressedKey == keybinds.esp then
            flags.visuals.esp = not flags.visuals.esp
        elseif pressedKey == keybinds.godMode then
            flags.combat.godMode = not flags.combat.godMode
        elseif pressedKey == keybinds.aimbot then
            flags.player.aimbot = not flags.player.aimbot
        end
        
        -- Update UI elements after keybind toggle
        for id, elem in pairs(uiElements) do
            if elem.tbl and elem.key then
                local isOn = elem.tbl[elem.key]
                elem.track.BackgroundColor3 = isOn and THEME.SwitchOn or THEME.SwitchOff
                TweenService:Create(elem.knob, TweenInfo.new(0.1), {Position = isOn and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)}):Play()
            end
        end
    end
end)

