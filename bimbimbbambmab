            keybindBtn.Text = "Press Key..."
            keybindBtn.TextColor3 = THEME.Yellow
            keybindAwaitingInput = {keyName = keybindName, btn = keybindBtn}
        end)

        -- Store UI element for updating
        uiElements[tostring(tbl) .. key] = {track = track, knob = knob, tbl = tbl, key = key}

        return keybindBtn
    end

