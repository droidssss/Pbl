-- [ LOGIC: REMOTES ] --
local function getRemotes()
    local r = ReplicatedStorage:FindFirstChild("remotes") or ReplicatedStorage:FindFirstChild("Remotes")
    if not r then return nil end
    return {
        sw = r:FindFirstChild("swing") or r:FindFirstChild("Swing"),
        hit = r:FindFirstChild("onHit") or r:FindFirstChild("OnHit"),
        fish = r:FindFirstChild("fishCaught") or r:FindFirstChild("FishCaught"),
        block = r:FindFirstChild("block") or r:FindFirstChild("Block")
    }
end

