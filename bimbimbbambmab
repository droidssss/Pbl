        i.TextColor3 = THEME.Accent
        i.Font = Enum.Font.GothamBold
        i.TextSize = 12
        Instance.new("UICorner", i)
        
        i.FocusLost:Connect(function() 
            local val = tonumber(i.Text)
            if val then
                if minVal and val < minVal then val = minVal end
                if maxVal and val > maxVal then val = maxVal end
                tbl[key] = val
            end
            i.Text = tostring(tbl[key])
        end)
    end

