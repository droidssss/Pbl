-- [[ HOTKEY SYSTEM ]] --
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    -- Handle setting keybind
    if keybindAwaitingInput and input.UserInputType == Enum.UserInputType.Keyboard then
        local keyName = tostring(input.KeyCode):match("KeyCode%.(.+)") or "Unknown"
        keybinds[keybindAwaitingInput.keyName] = input.KeyCode
        keybindAwaitingInput.btn.Text = "Key: " .. keyName
        keybindAwaitingInput.btn.TextColor3 = THEME.Accent
        keybindAwaitingInput = nil
        return
    end

    -- Handle feature toggling
    if not gameProcessed and input.UserInputType == Enum.UserInputType.Keyboard then
        local pressedKey = input.KeyCode
        
        if pressedKey == keybinds.combatEnabled then
